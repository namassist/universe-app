# Copy to `.env` beside this file and fill in. `.env` is git-ignored; never
# commit the filled version.

# ── Where this installation answers ──────────────────────────────────────────
# The address people type, WITH the scheme and no trailing slash. It is baked
# into the web bundle at build time, so changing it means:
#     docker compose build web && docker compose up -d web
# If HTTP_PORT is not 80, this must include it — http://192.168.1.50:8080.
PUBLIC_ORIGIN=http://192.168.1.50
# Change if something already owns port 80: ss -ltn '( sport = :80 )'
HTTP_PORT=80
# The host address that port is published on. 127.0.0.1 hides it from the
# network — use that (with a free HTTP_PORT such as 8080) when another proxy on
# the host owns 80/443, e.g. Coolify. See docs/deploy.md.
HTTP_BIND=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=universe_app
POSTGRES_DB=universe
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Redis (sessions) ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 24
REDIS_PASSWORD=

# ── The first account ────────────────────────────────────────────────────────
# Created by `db:bootstrap`. The password must satisfy PASSWORD_MIN_LENGTH or
# the bootstrap refuses to run — the most privileged account is not allowed to
# be weaker than the policy it enforces. Change it after the first login.
SUPERADMIN_IDENTIFIER=superadmin
SUPERADMIN_PASSWORD=

# The password every account created through the Users screen starts with, and
# is forced to change at first login. Required — the API refuses to boot
# without it.
DEFAULT_USER_PASSWORD=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# Mark the session cookie Secure. Only once HTTPS terminates in front of the
# app — over plain HTTP the browser drops the cookie and login fails silently.
COOKIE_SECURE=false

# The site's timezone. Shift boundaries, roster dates and every scheduler stage
# are compared against the container's local clock, so leaving this at a
# container's UTC default moves all of them by the site's offset — the wall
# shows the wrong shift and the stages fire at the wrong hour, both without
# any error. Asia/Makassar is WITA; Asia/Jakarta is WIB, Asia/Jayapura WIT.
TZ=Asia/Makassar

# ── External sources (read-only) ─────────────────────────────────────────────
# The attendance and FTW databases. Both are read strictly read-only; every
# session sets default_transaction_read_only.
ATTENDANCE_SOURCE_URL=
FTW_SOURCE_URL=

# The roster source (unggul_att), reached over HTTP rather than SQL. Both are
# required and the API refuses to start without them — it would otherwise boot
# and mirror nothing, which looks like a working system with a roster that
# never updates. SC is the standing key every request carries; the JWT it buys
# lasts an hour and is fetched per run, so it belongs nowhere on disk.
ROSTER_SOURCE_URL=
ROSTER_SOURCE_SC=

# Optional — the window the roster pull covers, counted from today. Defaults
# are 7 and 1: from a week back to the end of next month. Days back also bound
# what the mirror may delete; outside the window it knows nothing and so
# removes nothing.
# ROSTER_SYNC_DAYS_BACK=7
# ROSTER_SYNC_MONTHS_AHEAD=1

# ── Apitally (API monitoring) ────────────────────────────────────────────────
# Optional. Blank leaves monitoring off. Take the client ID from the Apitally
# dashboard (Settings → Apps). The API reaches hub.apitally.io over HTTPS, so
# the host needs outbound internet access.
APITALLY_CLIENT_ID=
# The dashboard environment this installation reports under.
APITALLY_ENV=prod
# Ship request/response headers, bodies and console output. Passwords, tokens,
# cookies, Authorization and sessionId are masked first; bodies still carry
# employee data, so set false if that must not leave the site.
APITALLY_REQUEST_LOGGING=true
