NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins.
# Mobile clients send no Origin header, so CORS does not apply to them.
CORS_ORIGINS=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://universe_app:CHANGE_ME@localhost:5432/universe_app

# Redis
REDIS_URL=redis://localhost:6379/2

# Bootstrap superadmin — read by `bun run db:seed` only, never at runtime.
# The identifier is an email or a NIK; the password is held to
# PASSWORD_MIN_LENGTH so the most privileged account cannot be weaker than the
# policy it enforces on everyone else. Rotate it after the first login.
SUPERADMIN_IDENTIFIER=superadmin@unggul.co.id
SUPERADMIN_PASSWORD=CHANGE_ME

# Password handed to imported accounts and to administrator-initiated resets.
# Such an account can authenticate but is refused everywhere else until it sets
# its own password, and this exact value is rejected as a new password.
DEFAULT_USER_PASSWORD=CHANGE_ME
PASSWORD_MIN_LENGTH=8

# Session lifetimes, in seconds. A web session slides on a 4h idle window but
# expires 12h after issuance regardless — one shift's length, so a session left
# open on a shared terminal does not carry into the next crew's shift. Bearer
# clients are off-shift by purpose and get idle expiry only.
SESSION_IDLE_SECONDS=14400
SESSION_ABSOLUTE_SECONDS=43200
BEARER_IDLE_SECONDS=2592000
DEVICE_SESSION_SECONDS=31536000

# Its own flag, deliberately NOT derived from NODE_ENV: a deployment may serve
# plain HTTP, and a browser silently discards a Secure cookie over HTTP. Set to
# true the moment TLS terminates in front of this API.
COOKIE_SECURE=false

# Where uploaded sound files are written. Explicit configuration, deliberately
# NOT derived from NODE_ENV: the right directory depends on how the API is
# deployed, not on which environment it believes it is in. On an ephemeral
# container this MUST be a mounted volume, or every uploaded sound is lost on
# redeploy. /health reports whether the directory is present and writable.
SOUND_DIR=./storage/sounds

# Where uploaded employee photos are written. Same reasoning as SOUND_DIR, with
# a sharper failure mode: a lost volume leaves photo_file_name pointing at a
# file that no longer exists, so the record claims a photo it cannot serve.
PHOTO_DIR=./storage/photos

# Where a roster upload waits between its preview and its commit. The least
# precious of the three: nothing in the database points here, every file is a
# copy the operator still has, and the commit re-parses what the client sends —
# so losing this directory costs a re-upload, never a wrong import.
IMPORT_DIR=./storage/imports

# The two external readiness sources, read-only, snapshotted by the ingest
# timeline stages. Required with no fallback for the same reason DATABASE_URL
# is: a default would silently point at the wrong site's data. Ask the source
# admins for READ-ONLY accounts — the ingest opens its sessions
# default_transaction_read_only, but the account should not be able to write
# even without that courtesy.
# savera "saverawatch" database (FTW verdicts):
FTW_SOURCE_URL=postgresql://readonly:password@192.168.151.21:5432/saverawatch
# Nakula database (fingerprint tap log):
ATTENDANCE_SOURCE_URL=postgresql://readonly:password@192.168.179.6:5432/Nakula

# savera hosts several companies in one database; ingest only this site's.
FTW_SOURCE_COMPANY_ID=2

# The roster source (unggul_att), over HTTP rather than SQL. SC is the standing
# key every request carries; it buys a JWT good for one hour, which the ingest
# fetches per run and never stores. Ask the unggul_att admins for the key —
# do not copy it out of an API collection into the repository.
ROSTER_SOURCE_URL=http://192.168.150.7:8426
ROSTER_SOURCE_SC=ask-the-unggul-att-admins

# The window the roster pull covers, counted from today. Forward-looking,
# unlike the readiness ingest: a roster is a plan, and what gets revised is the
# days that have not happened yet. The days back also bound the reconciliation —
# outside this window the mirror knows nothing and so deletes nothing.
ROSTER_SYNC_DAYS_BACK=7
ROSTER_SYNC_MONTHS_AHEAD=1

# How long an ingest stage keeps re-pulling after it fires. Each pass is an
# idempotent upsert, so the window is retry and late-arrival tolerance in one.
INGEST_WINDOW_MINUTES=5

# --- Fingerprint machine probing (monitoring TV) ---
# Every active machine is TCP-probed on port 4370 (the ZK protocol port) each
# interval — connect and close, never a ZK session, so the probe cannot contend
# with whatever collects taps. A machine is called offline only after
# PROBE_MISSES_BEFORE_OFFLINE consecutive misses, so one dropped packet does
# not flash red on a wall-mounted screen.
PROBE_INTERVAL_SECONDS=30
PROBE_TIMEOUT_MS=5000
# Probes run in batches: 58 at once was measured to time out the slower
# machines and report them offline while they were reachable.
PROBE_CONCURRENCY=10
PROBE_MISSES_BEFORE_OFFLINE=2

# --- The development fingerprint machine ---
# Points `fingerprint-device.test.ts` at real hardware. Unset, that suite skips
# itself: the parsing fixtures are captured from a machine, but from one, and
# this site has fifty-eight. Run it before a rollout and before adding a
# machine whose firmware nobody has read.
#
# Read-only, like everything in `sources/fingerprint.ts` — it asks what the
# machine holds and how many, and writes every request it makes to
# `device_requests`.
FINGERPRINT_TEST_IP=192.168.1.2
# The machine's communication key. 0 is the factory value and what the
# development machine answers to; production machines may each carry their own.
FINGERPRINT_TEST_COMKEY=0
