NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins.
# Mobile clients send no Origin header, so CORS does not apply to them.
CORS_ORIGINS=http://localhost:3000

# Postgres
DATABASE_URL=postgresql://universe_app:CHANGE_ME@localhost:5432/universe_app

# Redis
REDIS_URL=redis://localhost:6379/2

# Bootstrap superadmin — read by `bun run db:seed` only, never at runtime.
# The identifier is an email or a NIK; the password is held to
# PASSWORD_MIN_LENGTH so the most privileged account cannot be weaker than the
# policy it enforces on everyone else. Rotate it after the first login.
SUPERADMIN_IDENTIFIER=superadmin@unggul.co.id
SUPERADMIN_PASSWORD=CHANGE_ME

# Password handed to imported accounts and to administrator-initiated resets.
# Such an account can authenticate but is refused everywhere else until it sets
# its own password, and this exact value is rejected as a new password.
DEFAULT_USER_PASSWORD=CHANGE_ME
PASSWORD_MIN_LENGTH=8

# Session lifetimes, in seconds. A web session slides on a 4h idle window but
# expires 12h after issuance regardless — one shift's length, so a session left
# open on a shared terminal does not carry into the next crew's shift. Bearer
# clients are off-shift by purpose and get idle expiry only.
SESSION_IDLE_SECONDS=14400
SESSION_ABSOLUTE_SECONDS=43200
BEARER_IDLE_SECONDS=2592000
DEVICE_SESSION_SECONDS=31536000

# Its own flag, deliberately NOT derived from NODE_ENV: a deployment may serve
# plain HTTP, and a browser silently discards a Secure cookie over HTTP. Set to
# true the moment TLS terminates in front of this API.
COOKIE_SECURE=false
