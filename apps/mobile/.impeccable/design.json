  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action per screen: Masuk, Tempatkan, Simulasikan hasil scan.",
      "html": "<button class=\"ds-btn ds-btn-primary\" type=\"button\">Masuk</button>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-btn{min-height:52px;border-radius:14px;border:0;font:800 16px Figtree,system-ui,sans-serif;padding:0 18px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:filter .15s}.ds-btn:focus-visible{outline:3px solid var(--action);outline-offset:2px}.ds-btn-primary{background:var(--action);color:var(--action-ink)}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:active{filter:brightness(0.94)}.ds-btn-primary:disabled{background:var(--surface-2);color:var(--text-3);cursor:not-allowed}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action on a surface: Tandai semua dibaca, Scan lagi, Reset password.",
      "html": "<button class=\"ds-btn ds-btn-ghost\" type=\"button\">Scan lagi</button>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-btn{min-height:52px;border-radius:14px;border:0;font:800 16px Figtree,system-ui,sans-serif;padding:0 18px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:filter .15s}.ds-btn:focus-visible{outline:3px solid var(--action);outline-offset:2px}.ds-btn-ghost{background:var(--surface);color:var(--text);border:1px solid var(--line)}.ds-btn-ghost:hover{background:var(--surface-2)}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Outlined red, only for Keluar and Nonaktifkan akun.",
      "html": "<button class=\"ds-btn ds-btn-danger\" type=\"button\">Keluar</button>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-btn{min-height:52px;border-radius:14px;border:0;font:800 16px Figtree,system-ui,sans-serif;padding:0 18px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:filter .15s}.ds-btn:focus-visible{outline:3px solid var(--action);outline-offset:2px}.ds-btn-danger{background:none;color:var(--bad);border:1px solid var(--bad)}.ds-btn-danger:hover{background:var(--bad-soft)}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-ok",
      "description": "Soft status fill plus a word; never colour alone.",
      "html": "<div class=\"ds-row\"><span class=\"ds-badge ds-ok\">Lolos</span><span class=\"ds-badge ds-warn\">Terlambat</span><span class=\"ds-badge ds-bad\">Kosong</span><span class=\"ds-badge ds-info\">Plan</span><span class=\"ds-badge\">Belum tap</span></div>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-row{display:flex;gap:6px;flex-wrap:wrap}.ds-badge{display:inline-flex;align-items:center;font:700 12px Figtree,system-ui,sans-serif;padding:4px 9px;border-radius:999px;background:var(--surface-2);color:var(--text-2)}.ds-ok{background:var(--ok-soft);color:var(--ok)}.ds-warn{background:var(--warn-soft);color:var(--warn)}.ds-bad{background:var(--bad-soft);color:var(--bad)}.ds-info{background:var(--action-soft);color:var(--action)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Search with an inset icon; focus takes the 3px action outline.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg><input placeholder=\"Cari kode unit, mis. DT4084\" aria-label=\"Cari unit\"></label>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-search{position:relative;display:block;width:320px}.ds-search svg{position:absolute;left:14px;top:16px;color:var(--text-3)}.ds-search input{width:100%;height:50px;border-radius:14px;border:1px solid var(--line);background:var(--surface);color:var(--text);padding:0 16px 0 44px;font:15px Figtree,system-ui,sans-serif;box-sizing:border-box}.ds-search input:focus-visible{outline:3px solid var(--action);outline-offset:2px}"
    },
    {
      "name": "Hero Band",
      "kind": "custom",
      "refersTo": "hero-pill",
      "description": "Navy band: brand, shift chip, the day's fact at display size, status line, and status pills with words.",
      "html": "<section class=\"ds-hero\"><div class=\"ds-top\"><b class=\"ds-brand\">UNIVERSE</b><span class=\"ds-chip\">Shift Siang · Roster D</span></div><span class=\"ds-code\">DT4084</span><span class=\"ds-line\">Pegangan · rencana s.d. 05:26</span><div class=\"ds-pills\"><button class=\"ds-pill\" type=\"button\"><i class=\"ds-dot ds-dok\"></i>FTW lolos · 04:18</button><button class=\"ds-pill\" type=\"button\"><i class=\"ds-dot\"></i>BUS 07</button></div></section>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-hero{background:linear-gradient(180deg,var(--hero),var(--hero-2));color:var(--hero-text);padding:20px 18px 24px;display:flex;flex-direction:column;gap:8px;width:354px;border-radius:22px}.ds-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.ds-brand{font-weight:800;font-size:17px;letter-spacing:.08em}.ds-chip{font:600 13px Figtree,sans-serif;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18)}.ds-code{font-size:48px;font-weight:800;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-line{font-size:15px;font-weight:600;color:#FFD38A}.ds-pills{display:flex;gap:8px;margin-top:10px}.ds-pill{min-height:40px;display:inline-flex;align-items:center;gap:8px;padding:0 14px;border-radius:999px;background:rgba(3,10,30,.32);border:1px solid rgba(255,255,255,.22);color:var(--hero-text);font:600 14px Figtree,sans-serif;cursor:pointer}.ds-pill:hover{background:rgba(3,10,30,.45)}.ds-pill:focus-visible{outline:3px solid var(--brand);outline-offset:2px}.ds-dot{width:9px;height:9px;border-radius:5px;background:#9FB0CC}.ds-dok{background:#34D17A}"
    },
    {
      "name": "Menu Grid",
      "kind": "card",
      "refersTo": "menu-tile",
      "description": "Four-column menu on a white panel; 54px action-soft tiles over 12px labels.",
      "html": "<div class=\"ds-menu\"><button type=\"button\"><span class=\"ds-tile\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 16V8h10v8M13 11h4l3 3v2h-7\"/><circle cx=\"7\" cy=\"17\" r=\"2\"/><circle cx=\"17\" cy=\"17\" r=\"2\"/></svg></span>Unit saya</button><button type=\"button\"><span class=\"ds-tile\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg></span>Jadwal</button><button type=\"button\"><span class=\"ds-tile\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3\"/><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"/></svg></span>SIMPER</button><button type=\"button\"><span class=\"ds-tile\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Riwayat</button></div>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-menu{width:358px;background:var(--surface);border-radius:22px;padding:16px 6px 12px;display:grid;grid-template-columns:repeat(4,1fr);box-shadow:var(--shadow)}.ds-menu button{background:none;border:0;display:flex;flex-direction:column;align-items:center;gap:8px;font:600 12px Figtree,sans-serif;color:var(--text);cursor:pointer;border-radius:8px}.ds-menu button:focus-visible{outline:3px solid var(--action);outline-offset:2px}.ds-tile{width:54px;height:54px;border-radius:14px;background:var(--action-soft);color:var(--action);display:flex;align-items:center;justify-content:center;transition:transform .15s}.ds-menu button:hover .ds-tile{transform:translateY(-2px)}"
    },
    {
      "name": "List Group",
      "kind": "card",
      "refersTo": "list-group",
      "description": "Grouped rows on a 22px surface: unit code, muted second line, trailing status badge.",
      "html": "<div class=\"ds-group\"><div class=\"ds-lrow\"><span class=\"ds-txt\"><b>DT4102</b><span>EX1203 · PIT 3 SELATAN</span></span><span class=\"ds-b\">Kosong</span></div><div class=\"ds-lrow\"><span class=\"ds-txt\"><b>DT5131</b><span>EX1207 · PIT 1 UTARA</span></span><span class=\"ds-b\">Kosong</span></div></div>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-group{width:358px;background:var(--surface);border-radius:22px;box-shadow:var(--shadow);overflow:hidden}.ds-lrow{display:flex;align-items:center;gap:14px;padding:14px 16px;min-height:64px;border-bottom:1px solid var(--line);box-sizing:border-box}.ds-lrow:last-child{border-bottom:0}.ds-lrow:hover{background:var(--surface-2)}.ds-txt{flex:1;display:flex;flex-direction:column;gap:3px}.ds-txt b{font-size:16px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--text)}.ds-txt span{font-size:13px;color:var(--text-2)}.ds-b{font:700 12px Figtree,sans-serif;padding:4px 9px;border-radius:999px;background:var(--bad-soft);color:var(--bad)}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "nav-bar",
      "description": "Five columns; active item on an action-soft halo; centre action disc raised over the bar.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi utama\"><button type=\"button\" aria-current=\"page\"><span class=\"ds-halo\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 11 12 4l9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/></svg></span>Beranda</button><button type=\"button\"><span class=\"ds-halo\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg></span>Jadwal</button><button type=\"button\" class=\"ds-center\"><span class=\"ds-disc\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3\"/><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"/></svg></span>Kartu</button><button type=\"button\"><span class=\"ds-halo\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>Riwayat</button><button type=\"button\"><span class=\"ds-halo\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 16V8h10v8M13 11h4l3 3v2h-7\"/><circle cx=\"7\" cy=\"17\" r=\"2\"/><circle cx=\"17\" cy=\"17\" r=\"2\"/></svg></span>Unit</button></nav>",
      "css": ":host{--bg:#F2F4F7;--surface:#FFFFFF;--surface-2:#EDF0F4;--line:#DCE2EA;--text:#0B1220;--text-2:#46536A;--text-3:#5F6B80;--action:#0057D9;--action-ink:#FFFFFF;--action-soft:#E3EDFF;--hero:#0A2A63;--hero-2:#0F3A86;--hero-text:#FFFFFF;--hero-text-2:#C9D6F0;--brand:#00C0FF;--ok:#157A3E;--ok-soft:#E1F4E8;--warn:#9A5B00;--warn-soft:#FDF0D9;--bad:#B42323;--bad-soft:#FBE4E4;--shadow:0 6px 18px rgba(11,18,32,0.08),0 1px 3px rgba(11,18,32,0.06);font-family:Figtree,system-ui,sans-serif}.ds-nav{width:390px;height:88px;margin-top:34px;background:var(--surface);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);align-items:start;padding:8px 4px 0;box-sizing:border-box}.ds-nav button{background:none;border:0;display:flex;flex-direction:column;align-items:center;gap:4px;font:600 12px Figtree,sans-serif;color:var(--text-3);min-height:56px;cursor:pointer}.ds-nav button:hover{color:var(--text)}.ds-nav button:focus-visible{outline:3px solid var(--action);outline-offset:2px;border-radius:8px}.ds-halo{width:56px;height:32px;border-radius:16px;display:flex;align-items:center;justify-content:center}.ds-nav button[aria-current=page]{color:var(--text);font-weight:800}.ds-nav button[aria-current=page] .ds-halo{background:var(--action-soft);color:var(--action)}.ds-disc{width:62px;height:62px;margin-top:-34px;border-radius:31px;background:var(--action);color:var(--action-ink);border:5px solid var(--surface);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 14px rgba(3,6,14,.28);box-sizing:border-box}"
    }
  ],
  "narrative": {
    "northStar": "The Everyday App, Played Straight",
    "overview": "Universe Mobile is the category standard of a modern consumer app (wallet or banking class) carried at full craft and with no costume. There is no pit, no slip and no signage metaphor. The unit code and its status carry every home screen: a navy hero band at the top holds the one fact that matters today, and a rounded neutral sheet slides up over it with a four-column menu grid, grouped lists and the bottom bar of five with a raised centre button. Density is that of a phone app you already know: 16px page gutters, 64px list rows, 44px minimum touch targets.\n\nThe app follows the phone's theme. Light is a cool grey ground with white surfaces and a blue action; dark is a neutral charcoal ground with a cyan action. Navy belongs to the hero band (and the surfaces that quote it), never to the dark ground. Status reads in green, amber and red, and it always carries a word. All copy is Bahasa Indonesia; domain terms (Kosong, SIMPER, FTW, Pegangan, Spare) stay as the site uses them.\n\nThis prototype (`apps/mobile/prototype/index.html`) is the visual reference for stage 3: Compose Multiplatform translates it screen for screen. **Reference status.** The finish review ran three rounds; round 3 resolved every scored item except R1 (the \"4 unit kosong\" pill opened a Kosong board with two rows). After round 3 a third formation (EX1211 · PIT 2 TIMUR, DT4130 and DT4133 empty) was added to the sample board and the home \"Unit kosong\" list is now derived from the board, so pill, list and filtered board all show four; that fix was verified by the parent from a capture (`.impeccable/review/phone-pengawas-kosong.png`), not by the reviewer. **Unresolved:** the Laporan and Dashboard screens, iOS specifics, and the real QR (it will encode the NIK; the prototype shows a dashed placeholder).",
    "keyCharacteristics": [
      "Navy hero band with the cyan brand mark, then a rounded sheet on a neutral ground.",
      "One action colour per theme: blue `#0057D9` in light, cyan `#00C8FF` in dark.",
      "Status is colour plus a word, every time.",
      "Figtree throughout; tabular numerals for unit codes, NIKs and times.",
      "One corner family: 22px sheets and groups, 14px tiles and controls, full pills.",
      "Sample data is labelled as sample; screens not yet designed say so."
    ],
    "rules": [
      {
        "name": "The Word Beside the Colour Rule",
        "body": "Status is never colour alone. Every dot sits in a pill with words (\"FTW lolos · 04:18\"), every badge says Lolos, Kosong, Terlambat or Breakdown, and an empty seat reads \"Belum ada operator\" in red text, not just a red mark.",
        "section": "colors"
      },
      {
        "name": "The One Action Rule",
        "body": "Each theme has exactly one action colour: blue in light, cyan in dark. Status hues never style a button except the outlined red Keluar / Nonaktifkan danger button.",
        "section": "colors"
      },
      {
        "name": "The Navy Stays Up Top Rule",
        "body": "Navy is the hero band and the surfaces that quote it (ID card header, night-shift cells). The dark theme ground is neutral charcoal (`#111214`), never navy.",
        "section": "colors"
      },
      {
        "name": "The Code Carries the Screen Rule",
        "body": "The largest type on any home screen is a code or a count, set at 800 in tabular numerals. Nothing decorative competes with it.",
        "section": "typography"
      },
      {
        "name": "The Tabular Clock Rule",
        "body": "Every unit code, NIK, time and count is set with tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "Content surfaces share one ambient shadow; only the raised centre button gets more.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do follow the phone's light or dark theme, with blue action `#0057D9` in light and cyan `#00C8FF` in dark.",
      "Do put the day's single fact (unit code, count or time) at display size in the navy hero, with its status line directly under it.",
      "Do pair every status colour with a word: a pill, a badge or text.",
      "Do set unit codes, NIKs, times and counts in Figtree with tabular numerals.",
      "Do keep the corner family: 22px sheets and groups, 14px tiles and controls, full pills.",
      "Do label sample data as sample (\"Semua data di sini adalah contoh\"), on the amber sample band.",
      "Do show a spare as SPARE, with the reason and the 05:28 time, until finger-second; the seat appears only after it.",
      "Do route any screen not yet designed to the marked \"Belum dirancang\" placeholder with a way back to Beranda.",
      "Do write all copy in Bahasa Indonesia and keep site terms (Kosong, SIMPER, FTW, Pegangan, Spare) as they are."
    ],
    "donts": [
      "Don't use pit, slip or signage metaphors; the owner chose the familiar everyday app.",
      "Don't use colour alone to carry a status.",
      "Don't reveal a spare's seat before finger-second (05:28).",
      "Don't use navy as the dark-theme ground; it belongs to the hero band.",
      "Don't add a second action colour or style buttons with status hues (red outline danger excepted).",
      "Don't leave a dead tap: every menu item, pill and nav button goes somewhere, even if it is \"Belum dirancang\"."
    ]
  }
}
